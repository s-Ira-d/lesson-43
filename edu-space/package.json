{
  "name": "edu-space",
  "homepage": "https://s-Ira-d.github.io/lesson-43",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && copyfiles -u 1 dist/**/*.js dist/**/*.map public",
    "watch": "tsc --watch",
    "check": "tsc --noEmit",
    "dev": "vite",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d public"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "copyfiles": "^2.4.1",
    "gh-pages": "^6.3.0",
    "live-server": "^1.2.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
